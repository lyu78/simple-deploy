@startuml
!pragma charset UTF-8
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam Padding 4
skinparam ParticipantPadding 36
skinparam BoxPadding 21
skinparam BoxMargin 15
skinparam ArrowThickness 1
skinparam BoxBorderThickness 1
skinparam ParticipantBorderThickness 1
skinparam SequenceLifeLineBorderThickness 1
skinparam TitleFontSize 36
skinparam TitleFontStyle bold
skinparam TitleBorderThickness 0
skinparam TitleBackgroundColor white
skinparam ParticipantFontSize 22
skinparam ArrowFontSize 19
skinparam BoxFontSize 25
skinparam BoxFontStyle bold
skinparam ResponseMessageBelowArrow true
skinparam maxMessageSize 999
title simple-deploy: dry-run, build и размещение на DEV

actor "Оператор" as operator

box "Рабочая Windows-машина" #F7F7F7
participant ".venv/Scripts/simple-deploy.exe\nconsole script + CLI adapter" as runner
database "SQLite state\nlocal_state/simple_deploy.sqlite3" as state
collections "logs/\nлоги dry-run/build/deploy" as logs
end box

box "Локальные Git-репозитории" #EAF3FF
participant "simple-deploy repo\nоркестратор" as deploy_repo
participant "backend source repo\nBACKEND_SOURCE_REPO_PATH" as backend_src
participant "backend target repo\nBACKEND_TARGET_REPO_PATH" as backend_target
participant "frontend source repo\nFRONTEND_SOURCE_REPO_PATH" as frontend_src
participant "frontend target repo\nFRONTEND_TARGET_REPO_PATH" as frontend_target
end box

box "Артефакты релиза" #FFF7E6
collections "release directory\nRELEASE_ROOT_WINDOWS/<build_version>" as release_dir
participant "release_manifest.json\ncommits + SQL ranges + artifact names" as manifest
collections "backend/frontend tar.gz" as app_artifacts
collections "db_schema_dev/test/prod tar.gz" as schema_artifacts
collections "db_insert/db_update/db_set_default tar.gz" as data_artifacts
collections "tools-ci/maintenance_stub/maintenance_stub.tar.gz\nuniversal maintenance page" as maintenance_stub
end box

box "DEV контур" #E8F8EA
participant "DEV app VM\nbackend/frontend paths" as dev_app
database "DEV DB VM\nPostgreSQL + psql" as dev_db
end box

== 1. Dry-run ==

operator -> runner: dry-run
runner -> deploy_repo: проверить локальный repo и config files
runner -> backend_src: проверить Git repo, branch, origin URL
runner -> frontend_src: проверить Git repo, branch, origin URL
runner -> dev_app: проверить SSH, runtime, release paths, service permissions
runner -> dev_db: проверить SSH, psql и PostgreSQL login
runner -> maintenance_stub: проверить наличие default stub archive
runner -> logs: записать dry-run log
runner --> operator: DRY-RUN PASS/FAIL/SKIP

== 2. Build ==

operator -> runner: build
runner -> backend_src: git checkout dev + git pull
runner -> frontend_src: git checkout dev + git pull
runner -> backend_target: создать sync branch, скопировать backend source, commit/push
runner -> frontend_target: создать sync branch, скопировать frontend source, commit/push

runner -> state: прочитать baseline dev/test/prod
runner -> backend_src: create_sql_migrations.py
backend_src -> backend_src: git diff baseline..HEAD для Django migration-файлов
backend_src -> backend_src: offline PostgreSQL DDL без чтения django_migrations из БД
backend_src --> runner: summary_sql_dev/test/prod + schema_migrations_metadata.json

runner -> backend_src: create_run_all_sql.py
backend_src --> runner: run_all_insert.sql + run_all_update_*.sql/sh + run_all_set_default_*.sql/sh

runner -> release_dir: создать директорию релиза
runner -> schema_artifacts: упаковать db_schema_dev/test/prod
runner -> data_artifacts: упаковать db_insert/db_update/db_set_default
runner -> app_artifacts: упаковать backend/frontend
runner -> manifest: записать build_version, commits, SQL ranges, artifact names
runner -> state: записать release metadata
runner --> operator: build completed

== 3. DEV deploy ==

operator -> runner: deploy --latest --contour dev
runner -> release_dir: выбрать release
runner -> app_artifacts: найти backend/frontend archives
runner -> schema_artifacts: найти db_schema_dev archive
runner -> data_artifacts: найти db_insert + db_update_parallel archives
runner -> maintenance_stub: взять universal stub archive
runner -> dev_app: upload backend/frontend + maintenance stub
runner -> dev_app: service steps before_unpack, остановить backend/workers
runner -> dev_app: unpack maintenance stub в FRONTEND_RELEASE_PATH
runner -> dev_db: upload + unpack db_schema_dev/db_insert/db_update_parallel
runner -> dev_db: psql --single-transaction -f summary_sql_dev_*.sql
runner -> dev_db: psql -f run_all_insert_*.sql
runner -> dev_db: bash run_all_update_parallel_*.sh\nlive [START]/[RUNNING]/wave logs
runner -> dev_db: DB maintenance + sql_scripts
runner -> dev_app: unpack backend
runner -> dev_app: python manage.py migrate --fake
runner -> dev_app: python manage.py sync_action_role
runner -> dev_app: service steps after_migrate, поднять backend/workers
runner -> dev_app: unpack frontend, заменить stub
runner -> dev_app: healthcheck

alt DEV deploy successful
    runner -> state: mark-applied dev, last_success = backend commit релиза
    runner --> operator: DEV deploy success
else DEV deploy failed
    runner -> state: record failed attempt, baseline не меняется
    runner --> operator: DEV deploy failed
end

@enduml
