{
  "backup_enabled": false,
  "maintenance_stub_enabled": true,
  "maintenance_stub_archive_path": "tools-ci/maintenance_stub/maintenance_stub.tar.gz",
  "data_sql_enabled": true,
  "db_maintenance_enabled": true,
  "db_psql_bin": "psql",
  "db_psql_host": "localhost",
  "db_maintenance_sql_phase": "after_migrate",
  "db_maintenance_sql": [
    "VACUUM ANALYZE;"
  ],
  "db_maintenance_sql_timeout_seconds": 900,
  "db_data_sql_timeout_seconds": 21600,
  "db_update_parallel_max_workers": 8,
  "db_update_parallel_status_interval_seconds": 30,
  "sql_scripts": [
    {
      "path": "sql/public_table_size_report.sql",
      "phase": "after_migrate"
    },
    {
      "path": "sql/public_table_maintenance_diagnostics.sql",
      "phase": "after_migrate"
    }
  ],
  "management_commands": [],
  "service_permission_checks_enabled": true,
  "service_steps": [
    {
      "name": "ensure example cache before management",
      "phase": "after_unpack",
      "command": "sudo /bin/systemctl start example-cache.service",
      "permission_check_command": "sudo /bin/systemctl start example-cache.service"
    },
    {
      "name": "status example cache before management",
      "phase": "after_unpack",
      "command": "systemctl status example-cache.service",
      "permission_check_command": "systemctl status example-cache.service"
    },
    {
      "name": "restart example backend",
      "phase": "after_migrate",
      "command": "sudo /bin/systemctl restart example-backend.service",
      "permission_check_command": "sudo /bin/systemctl restart example-backend.service"
    },
    {
      "name": "status example backend",
      "phase": "after_migrate",
      "command": "systemctl status example-backend.service",
      "permission_check_command": "systemctl status example-backend.service"
    },
    {
      "name": "restart custom app",
      "phase": "after_migrate",
      "command": "/opt/example/bin/restart-example-app",
      "permission_check_command": "test -x /opt/example/bin/restart-example-app"
    }
  ],
  "healthcheck_enabled": true,
  "healthcheck_validate_certs": false,
  "healthcheck_retries": 30,
  "healthcheck_delay": 5,
  "portal_version_check_enabled": true,
  "portal_version_asset_limit": 20,
  "healthcheck_commands": [],
  "outlook_email_enabled": false,
  "outlook_email_recipients": [
    "dev-team@example.local"
  ],
  "outlook_email_cc": [],
  "outlook_email_subject": "Деплой успешно завершен: {build_version}",
  "outlook_email_body": "Деплой успешно завершен.\n\nВерсия сборки: {build_version}\nСтенд: {stand_url}\nКаталог релиза: {release_dir}\n\nАртефакты:\n{artifacts_text}\n\nИзменения с предыдущего релиза:\n{release_changelog_text}",
  "outlook_email_required": false
}
