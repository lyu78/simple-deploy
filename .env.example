# Локальная конфигурация simple-deploy.
# Скопируйте файл в .env и замените примеры значениями своей рабочей машины.
# Значения ниже приближены к реальности по формату, но не являются реальными адресами.
# .env не должен попадать в репозиторий.

# Необязательно: если пусто, Ansible считает корень проекта от inventory.
# Пример WSL-пути: /mnt/c/example/simple-deploy
PROJECT_ROOT_WSL=

# Необязательно: если пусто, релизы складываются в <корень проекта>/releases.
# Пример WSL-пути: /mnt/c/example/simple-deploy/releases
RELEASE_ROOT_WSL=

# Необязательно: если пусто, путь строится из RELEASE_ROOT_WSL для Git Bash.
# Пример Git Bash-пути: /c/example/simple-deploy/releases
RELEASE_ROOT_BASH=

# Базовая продуктовая версия, к которой сборщик добавляет дату/время.
BUILD_VERSION_BASE=1.0.3

# Windows-путь к Git Bash.
GIT_BASH_PATH=C:\Program Files\Git\git-bash.exe

# Windows-пути к рабочим копиям внешнего и внутреннего backend.
BACKEND_SOURCE_REPO_PATH=C:/example/repos/backend-source
BACKEND_TARGET_REPO_PATH=C:/example/repos/backend-target

# Нужен backend shell-архиватору, который работает в Git Bash.
BACKEND_TARGET_REPO_PATH_BASH=/c/example/repos/backend-target

# Windows-пути к рабочим копиям внешнего и внутреннего frontend.
FRONTEND_SOURCE_REPO_PATH=C:/example/repos/frontend-source
FRONTEND_TARGET_REPO_PATH=C:/example/repos/frontend-target
# Отдельного FRONTEND_TARGET_REPO_PATH_BASH сейчас нет: frontend-архиватор
# запускается из рабочей директории frontend-репозитория и использует RELEASE_ROOT_BASH.

# Сетевые адреса VM. Можно указать IP или DNS-имя.
APP_VM_HOST=192.0.2.10
APP_VM_USER=deploy
DB_VM_HOST=192.0.2.11
DB_VM_USER=deploy

# PostgreSQL доступен с управляющей машины Ansible.
DB_PORT=5432
DB_NAME=example_dev_db

# Linux-пути на app VM.
REMOTE_TMP_ROOT=/tmp/simple-deploy
BACKEND_RELEASE_PATH=/opt/example/backend
FRONTEND_RELEASE_PATH=/opt/example/frontend
APP_WORKDIR=/opt/example/backend
APP_VENV_ACTIVATE_PATH=/opt/example/backend/venv/bin/activate
APP_MANAGE_PY_PATH=project/manage.py
BACKUP_ROOT_BASE=/opt/example/backups

# Домены стендов без схемы https://.
DEV_DOMAIN=dev.example.local
TEST_DOMAIN=test.example.local:443
PROD_DOMAIN=prod.example.local:443

# Имена серверов, которые попадают в имя frontend-архива.
FRONTEND_TEST_SERVER_NAME=EXAMPLE-T
FRONTEND_PROD_SERVER_NAME=EXAMPLE-P
